# Local secret; put the real value only in backend/.env.
OPENAI_API_KEY=
# Execution mode: fallback, replay, record or live.
LLM_MODE=fallback
# P2 selects the extraction model after smoke.
MODEL_EXTRACT=
# P2 selects the scope model after smoke.
MODEL_AGENT=
# Optional inexpensive model, selected by P2.
MODEL_CHEAP=
# Embedding model; verify with P2 smoke.
EMBED_MODEL=text-embedding-3-small
# Extraction reasoning effort.
LLM_EFFORT_EXTRACT=low
# Scope reasoning effort.
LLM_EFFORT_AGENT=medium
# Maximum model output tokens.
LLM_MAX_OUTPUT_TOKENS=16000
# Replay files, relative to backend.
REPLAY_DIR=../fixtures/replay
# Enable vision input.
LLM_VISION=1
# Shared run model-call cap; tune at S0.
RUN_MAX_MODEL_CALLS=24
# Shared run deadline in seconds; tune at S0.
RUN_DEADLINE_S=120
# Agent-only model-call cap.
AGENT_MAX_MODEL_CALLS=10
# Agent-only tool-call cap.
AGENT_MAX_TOOL_CALLS=16
# Optional manager turn cap.
AGENT_MANAGER_TURNS=3
# Agent retrieval hop cap.
AGENT_RETRIEVAL_HOPS=2
# Agent deadline within the run deadline.
AGENT_DEADLINE_S=75
# Maximum passages for single-call resolution.
AGENT_SINGLE_CALL_MAX=8
# Web discovery toggle: on or off.
WEB_SEARCH=off
# Search provider: openai or tavily.
WEB_PROVIDER=openai
# Maximum searches in a run.
WEB_MAX_SEARCHES=3
# Maximum pages fetched in a run.
WEB_MAX_PAGES=4
# Enable optional OCR.
OCR_ENABLED=1
# Enable agent tracing; never capture secrets.
AGENTS_TRACING=1
# Prevent recording mutation after freeze.
REPLAY_FREEZE=0
# Execute worker in-process when 1.
WORKER_INLINE=0
# Presentation delay; zero for checks.
DEMO_RUN_DELAY_S=0
# SQLite database, relative to backend.
DB_PATH=passport.db
# Source fixtures, relative to backend.
FIXTURES_DIR=../fixtures
# Blank reads backend/tests/PHASE; override explicitly for lane checks.
CONTEST_PHASE=
